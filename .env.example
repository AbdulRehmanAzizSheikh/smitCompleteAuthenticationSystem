# ─────────────────────────────────────────────────────────────
#  Aegis Auth — Environment Variables
#  Copy this file to `.env.local` and fill in real values.
#  NEVER commit `.env.local` to git.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aegis-auth?retryWrites=true&w=majority

# Secret used to sign session JWTs (generate: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-long-random-string

# Session lifetime in days (default 7)
SESSION_TTL_DAYS=7

# Hostinger SMTP (Business Email → mail@abdulrehman.sbs)
# Host: smtp.hostinger.com | Port: 465 (SSL) or 587 (STARTTLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=mail@abdulrehman.sbs
SMTP_PASS=your-hostinger-app-password
EMAIL_FROM="Aegis Auth <mail@abdulrehman.sbs>"

# Public base URL of the app (used in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
