# ─────────────────────────────────────────────────────────────
#  Aegis Auth — Environment Variables (reference)
#
#  Local dev : copy this file to `.env.local` and fill real values
#              (`.env.local` is git-ignored, stays on your machine)
#  Vercel    : copy the same keys into Project → Settings →
#              Environment Variables (this file itself is safe to
#              commit — it contains no secrets)
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string, including the database name.
# Atlas → Connect → Drivers → "mongodb+srv://…" then append /<db-name>
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Secret used to sign the session JWT (HS256).
# Generate one:  openssl rand -base64 48   (or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
# Use a DIFFERENT secret per environment — never reuse local in production.
JWT_SECRET=replace-with-a-long-random-string

# Sliding session lifetime in days. The token is re-issued on every
# visit; it only expires after N days with no activity.
SESSION_TTL_DAYS=7

# Hostinger SMTP (Business Email → mail@abdulrehman.sbs)
# 465 = SSL, 587 = STARTTLS. Use an app password / mailbox password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=mail@abdulrehman.sbs
SMTP_PASS=your-hostinger-app-password
EMAIL_FROM="Aegis Auth <mail@abdulrehman.sbs>"

# Public base URL of the deployed app — used inside email templates.
# Local: http://localhost:3000 · Vercel: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
